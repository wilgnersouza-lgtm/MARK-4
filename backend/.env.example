# ==================== SERVIDOR ====================
PORT=5000
NODE_ENV=development

# ==================== AUTENTICAÇÃO JWT ====================
# Gere uma chave nova com: openssl rand -hex 32
JWT_SECRET=troque-esta-chave-antes-de-subir-para-producao
JWT_EXPIRY=24h

# ==================== CORS ====================
# Origem do frontend (Vite roda na 3000)
CORS_ORIGIN=http://localhost:3000

# ==================== UPLOAD ====================
MAX_UPLOAD_SIZE=52428800

# ==================== DATA ====================
DATA_DIR=./data

# ==================== AUTH0 (Opcional) ====================
AUTH0_DOMAIN=
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=
